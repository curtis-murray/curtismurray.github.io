# PostHog product analytics (autocapture + session replay).
# Copy to `.env` for local testing, or set these in the production build
# environment (GitHub Actions). The snippet in src/layouts/Layout.astro only
# loads when PUBLIC_POSTHOG_KEY is present, so leaving these unset = no tracking.

# Your PostHog project's "Project API Key" (safe to expose; it's a public key).
PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ingestion host. Defaults to https://us.i.posthog.com (US cloud) if unset.
# Set to https://eu.i.posthog.com for an EU project.
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
