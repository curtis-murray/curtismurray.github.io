---
// Shared layout for the morphology blog series. Renders the article inside the
// site's interior-page shell (translucent reading panel over the fixed mountain
// backdrop + StoryNav + Lenis + SiteFooter — all from Layout's non-story
// branch), then the series nav, then the interactive engine.
//
// The engine (audio-data → morphology-data → morphology-engine) is loaded
// is:inline, in this exact order, AFTER the slotted article: it's an IIFE that
// scans `.wrap`/`.wide` and renders `.cardslot` cards at run time, so the
// content must already be in the DOM. is:inline keeps load order and the
// window.* globals intact (no Astro bundling). Assets are served from
// /public/blog/morphology-tamil/.
import Layout from "./Layout.astro";
import "../styles/blog/blog.css";
import "../styles/blog/morphology-cards.css";

interface NavLink {
  href: string;
  dir: string;
  ttl: string;
}
interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  prev?: NavLink;
  next?: NavLink;
}
const { title, description, image, imageAlt, prev, next } = Astro.props;
const base = "/blog/morphology-tamil";
---

<Layout title={title} description={description} image={image} imageAlt={imageAlt}>
  <slot />

  {/* Completion sentinel: sits at the end of the article body. When it scrolls
      into view we fire blog_post_completed once — a proxy for "read to the end". */}
  <div id="blog-end" data-post={Astro.url.pathname} aria-hidden="true"></div>

  <nav class="series-nav">
    {
      prev && (
        <a class="prev" href={prev.href}>
          <span class="dir">{prev.dir}</span>
          <span class="ttl">{prev.ttl}</span>
        </a>
      )
    }
    <a class="hub" href="/blog/">Series home</a>
    {
      next && (
        <a class="next" href={next.href}>
          <span class="dir">{next.dir}</span>
          <span class="ttl">{next.ttl}</span>
        </a>
      )
    }
  </nav>

  <script is:inline>
    // Fire blog_post_completed once when the end-of-article sentinel is reached.
    (function () {
      var s = document.getElementById("blog-end");
      if (!s || !("IntersectionObserver" in window)) return;
      var fired = false;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting && !fired && window.posthog) {
            fired = true;
            window.posthog.capture("blog_post_completed", {
              post: s.getAttribute("data-post"),
            });
            io.disconnect();
          }
        });
      });
      io.observe(s);
    })();
  </script>

  <script is:inline src={`${base}/audio-data.js`}></script>
  <script is:inline src={`${base}/shared/morphology-data.js`}></script>
  <script is:inline src={`${base}/shared/morphology-engine.js`}></script>
</Layout>
