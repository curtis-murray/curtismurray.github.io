---
import "../styles/global.css";
import Header from "../components/Header";
import StoryNav from "../components/StoryNav";
import SiteFooter from "../components/SiteFooter.astro";
import MountainScene from "../components/MountainScene.astro";
import { getCollection } from "astro:content";
const menuItems = await getCollection("menu");
const pathname = new URL(Astro.request.url).pathname;
import { SEO } from "astro-seo";
import config from "../config/config.json";
// `story` pages (the home) render full-bleed over the mountains; every other
// route renders inside a centred, translucent base-100 panel.
const { title, description, story = false, image } = Astro.props;
// Canonical URL + absolute OG/Twitter image. Pages may pass their own `image`
// (e.g. a per-post card); everything else falls back to the site-wide card.
// Social scrapers (LinkedIn, X, Slack) require absolute URLs, hence Astro.site.
const metaDescription = description ? description : config.metadata.meta_description;
const pageTitle = title ? title : config.site.title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image ?? "/og/og-default.png", Astro.site).href;
const ogImageAlt = "Curtis Murray — AI Engineer, PhD, Melbourne";
// PostHog product analytics: autocapture (clicks/forms) + session replay.
// Only loads when PUBLIC_POSTHOG_KEY is set — so local dev (no key) stays clean
// and the snippet ships only when the production build supplies the key.
// Host defaults to app.posthog.com (US cloud). For an EU project set
// PUBLIC_POSTHOG_HOST to https://eu.i.posthog.com.
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
// Default to app.posthog.com (matches the sibling Ellytails site, confirmed
// working on this same project key). The raw us.i.posthog.com ingestion host is
// on common ad/tracker blocklists (*.i.posthog.com), which silently drops
// events; app.posthog.com routes to the same US cloud and slips through.
// `||` not `??`: an unset GitHub Actions variable injects an empty string (not
// undefined), and `??` would keep that "" and break PostHog's api_host in prod.
const posthogHost =
  import.meta.env.PUBLIC_POSTHOG_HOST || "https://app.posthog.com";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SEO
      title={pageTitle}
      description={metaDescription}
      canonical={canonical}
      openGraph={{
        basic: {
          title: pageTitle,
          type: "website",
          image: ogImage,
          url: canonical,
        },
        optional: {
          description: metaDescription,
          siteName: "Curtis Murray",
          locale: "en_AU",
        },
        image: {
          alt: ogImageAlt,
          width: 1200,
          height: 600,
        },
      }}
      twitter={{
        card: "summary_large_image",
        title: pageTitle,
        description: metaDescription,
        image: ogImage,
        imageAlt: ogImageAlt,
      }}
      extend={{
        link: [
          { rel: "shortcut icon", href: `${config.site.favicon}` },
          {
            rel: "icon",
            type: "image/png",
            sizes: "32x32",
            href: "/assets/favicons/favicon-32x32.png",
          },
          {
            rel: "icon",
            type: "image/png",
            sizes: "16x16",
            href: "/assets/favicons/favicon-16x16.png",
          },
          {
            rel: "apple-touch-icon",
            sizes: "180x180",
            href: "/assets/favicons/apple-touch-icon.png",
          },
          {
            rel: "mask-icon",
            href: "/assets/favicons/safari-pinned-tab.svg",
            color: "#da532c",
          },
          { rel: "manifest", href: "/assets/favicons/site.webmanifest" },
          { rel: "preconnect", href: "../fonts.googleapis.com/index.html" },
          { rel: "preconnect", href: "../fonts.gstatic.com/index.html" },
          {
            rel: "preconnect",
            href: "https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&amp;family=Roboto+Slab:wght@300;400;500;600;700;800;900&amp;display=swap",
          },
        ],
        meta: [
          {
            name: "viewport",
            content: "width=device-width, initial-scale=1.0",
          },
          { name: "theme-color", content: "#ffffff" },
          { name: "msapplication-TileColor", content: "#da532c" },
          {
            name: "msapplication-config",
            content: "/assets/favicons/browserconfig.xml",
          },
        ],
      }}
    />
    <!-- commom meta tag -->
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <script is:inline>
      // No-flash theme bootstrap. Runs before paint: sets BOTH the DaisyUI
      // [data-theme] token set and the legacy `dark` class (kept so any
      // not-yet-migrated `dark:`-class components still resolve). localStorage
      // key "theme" with values "light"/"dark" is preserved.
      (function () {
        var q = new URLSearchParams(location.search).get("theme");
        if (q === "light" || q === "dark") localStorage.theme = q;
        var dark =
          localStorage.theme === "dark" ||
          (!("theme" in localStorage) &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        var root = document.documentElement;
        root.dataset.theme = dark ? "catppuccin" : "autumn-day";
        root.classList.toggle("dark", dark);
        // Enable scroll-reveal hiding only now that JS is confirmed running.
        root.classList.add("reveal-on");
      })();
    </script>
    {
      posthogKey && (
        <script define:vars={{ posthogKey, posthogHost }}>
          !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug getPageViewId captureTraceFeedback captureTraceMetric".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);posthog.init(posthogKey,{api_host:posthogHost,person_profiles:"identified_only"});
        </script>
      )
    }
  </head>
  <body class="text-base-content">
    <MountainScene />
    <div class="relative min-h-screen w-full">
      <Header client:load activeMenuId={pathname} menuItems={menuItems} />
      <StoryNav client:load activeMenuId={pathname} menuItems={menuItems} />
      {
        story ? (
          <main class="[view-transition-name:vt-content]">
            <slot />
          </main>
        ) : (
          <main class="[view-transition-name:vt-content]">
            <div class="container mr-auto ml-auto px-4 sm:px-6 lg:px-10 pt-6 lg:pt-10 pb-20">
              <div class="rounded-2xl bg-base-100/80 backdrop-blur-md shadow-xl ring-1 ring-base-300/40 p-6 sm:p-10 lg:p-12 reveal reveal-1">
                <slot />
              </div>
            </div>
            <SiteFooter />
          </main>
        )
      }
    </div>
    <script>
      // Reveal story chapters as they scroll into view (.io-reveal → .is-visible).
      const els = document.querySelectorAll(".io-reveal");
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      if (els.length) {
        if (reduce || !("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("is-visible"));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  io.unobserve(entry.target);
                }
              });
            },
            { rootMargin: "0px 0px -12% 0px", threshold: 0.12 }
          );
          els.forEach((el) => io.observe(el));
        }
      }
    </script>
    <script>
      // Whole-page smooth scroll (Lenis). Window-based, so the fixed mountains
      // and sticky columns keep working. Disabled under reduced-motion.
      import Lenis from "lenis";
      const noMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      if (!noMotion) {
        const lenis = new Lenis({ duration: 1.05, smoothWheel: true });
        // Exposed so islands (e.g. the grind page's reveal) can scrollTo through it.
        window.__lenis = lenis;
        const raf = (t) => {
          lenis.raf(t);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
        // smooth in-page anchor jumps (e.g. "come see how" → #thesis)
        document.addEventListener("click", (e) => {
          const a = e.target.closest && e.target.closest('a[href^="#"]');
          if (!a) return;
          const id = a.getAttribute("href");
          if (id && id.length > 1) {
            const el = document.querySelector(id);
            if (el) {
              e.preventDefault();
              lenis.scrollTo(el, { offset: -10 });
            }
          }
        });
      }
    </script>
  </body>
</html>
