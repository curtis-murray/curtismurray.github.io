---
// Fixed, full-viewport mountain backdrop. Replaces the old #bg-mesh.
// Seven token-coloured ridgelines receding into haze + a sun/moon glow, with
// gentle scroll parallax (back layers move least) and slow mouse drift.
// Colours come entirely from CSS vars defined per [data-theme] in global.css,
// so dawn (autumn-day) ↔ dusk (catppuccin) switch automatically — no JS branch.
import { ridgePath } from "../utils/ridge.js";

const W = 1440;
const H = 640;

// back (light, high, slow) → front (dark, low, fast)
const layers = [
  { baseline: 250, amp: 30, seed: 11 },
  { baseline: 292, amp: 36, seed: 23 },
  { baseline: 332, amp: 42, seed: 37 },
  { baseline: 374, amp: 48, seed: 53 },
  { baseline: 416, amp: 52, seed: 71 },
  { baseline: 458, amp: 56, seed: 89 },
  { baseline: 500, amp: 60, seed: 103 },
].map((l, i) => ({
  d: ridgePath({ ...l, width: W, bleed: 70 }, { floor: H }),
  idx: i + 1,
}));
---

<div id="mtn-scene" aria-hidden="true">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMax slice"
    width="100%"
    height="100%"
  >
    <defs>
      <linearGradient id="mtn-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" style="stop-color:var(--mtn-sky-top)" />
        <stop offset="100%" style="stop-color:var(--mtn-sky-bottom)" />
      </linearGradient>
      <radialGradient id="mtn-glow" cx="0.7" cy="0.42" r="0.55">
        <stop offset="0%" style="stop-color:var(--mtn-glow);stop-opacity:0.9" />
        <stop offset="55%" style="stop-color:var(--mtn-glow);stop-opacity:0.18" />
        <stop offset="100%" style="stop-color:var(--mtn-glow);stop-opacity:0" />
      </radialGradient>
    </defs>

    <rect x="0" y="0" width={W} height={H} fill="url(#mtn-sky)"></rect>
    <circle cx={W * 0.7} cy={H * 0.4} r={H * 0.9} fill="url(#mtn-glow)"></circle>

    {
      layers.map((l) => (
        <g class="mtn-layer" style={`--d:${l.idx}`}>
          <path
            class="mtn-wave"
            d={l.d}
            fill={`var(--mtn-${l.idx})`}
            style={`--wx:${(l.idx % 2 ? 1 : -1) * (5 + l.idx * 2)}px; --wy:${-(2 + l.idx * 0.7).toFixed(1)}px; --wdur:${(30 - l.idx * 1.4).toFixed(1)}s; --wdelay:${(-l.idx * 2.6).toFixed(1)}s`}
          />
        </g>
      ))
    }
  </svg>
</div>
<div id="mtn-dusk" aria-hidden="true"></div>

<script>
  // Scroll parallax (per-layer, depth-weighted) + slow eased mouse drift.
  // Both gated on prefers-reduced-motion.
  const scene = document.getElementById("mtn-scene");
  const dusk = document.getElementById("mtn-dusk");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (scene && !reduce) {
    let tx = 0,
      cx = 0,
      ticking = false;

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        scene.style.setProperty("--scroll", String(window.scrollY));
        if (dusk) {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const progress = max > 0 ? window.scrollY / max : 0;
          dusk.style.opacity = String(Math.min(progress * 1.05, 1) * 0.6);
        }
        ticking = false;
      });
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    const RANGE = 18;
    window.addEventListener("mousemove", (e) => {
      tx = (e.clientX / window.innerWidth - 0.5) * RANGE;
    });
    const drift = () => {
      cx += (tx - cx) * 0.025;
      scene.style.setProperty("--px", cx.toFixed(2) + "px");
      requestAnimationFrame(drift);
    };
    drift();
  }
</script>
