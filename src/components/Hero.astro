---
// Opening hero shell: mountains (global) + flowing topo lines + scroll cue.
// The animated content (typed name → photo pop → typed tagline → fade-in rest)
// lives in the HeroContent island.
import TopoLines from "./TopoLines.astro";
import HeroContent from "./HeroContent.jsx";
---

<section class="relative min-h-[100svh] flex items-center overflow-hidden">
  <TopoLines
    count={11}
    baseline={120}
    spread={11}
    class="pointer-events-none absolute inset-x-0 top-[14%] h-[42%] opacity-90"
  />

  {/* Soft readability wash behind the text column — base-100 vs base-content so
      it lifts contrast in both themes; fades out toward the photo on the right. */}
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-r from-base-100/90 via-base-100/55 to-transparent"
  >
  </div>

  <div class="container mx-auto px-6 lg:px-16 pt-28 pb-28 relative">
    <HeroContent client:load />
  </div>

  <a
    href="#thesis"
    aria-label="Scroll to the story"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 text-base-content/50 hover:text-primary transition-colors animate-bounce"
  >
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
  </a>
</section>
