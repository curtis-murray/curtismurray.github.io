---
// Aaron-Walter-style chapter list: big titles on the left, role + dates on the
// right, an arrow, and thin topographic lines streaming through the rows.
import TopoLines from "./TopoLines.astro";
import TypeOnView from "./TypeOnView.jsx";

const items = [
  {
    title: "spoken tamil morphology analyser",
    role: "neuro-symbolic agentic ai · custom mcp server + neo4j",
    dates: "2025 — Present",
    href: "/the-grind/",
  },
  {
    title: "clinical entity linking",
    role: "beat string matching, ClinicalBERT & raw LLM generation · RMIT",
    dates: "2024 — 2025",
    href: "/the-grind/",
  },
  {
    title: "patient experience nlp",
    role: "phd · flagged covid anosmia in reddit before it was widely clinically recognised",
    dates: "2020 — 2025",
    href: "/the-grind/",
  },
];
---

<section id="work" class="relative py-16 sm:py-24">
  <div class="container mx-auto px-6 lg:px-16">
    <div
      class="io-reveal relative overflow-hidden rounded-3xl bg-base-100/55 backdrop-blur-md ring-1 ring-base-300/25 shadow-lg px-6 py-10 sm:px-12 sm:py-14"
    >
      <TopoLines
        count={14}
        baseline={120}
        spread={14}
        class="pointer-events-none absolute right-0 top-0 h-full w-[62%] opacity-80"
      />

      <p
        class="relative text-sm font-medium tracking-[0.16em] text-primary mb-2"
      >
        selected work
      </p>
      <h2
        class="relative font-slab font-bold text-base-content text-3xl sm:text-[2.5rem] tracking-tight mb-4"
      >
        <TypeOnView client:visible text="one thesis, three problems." />
      </h2>

      <ul class="relative">
        {
          items.map((item, i) => (
            <li>
              <a
                href={item.href}
                class="group grid grid-cols-[auto_1fr] sm:grid-cols-[auto_1fr_auto_auto] items-baseline gap-x-4 sm:gap-x-8 gap-y-1 border-t border-base-content/15 py-6 sm:py-7 transition-colors"
              >
                <span class="font-slab text-sm text-base-content/40 tabular-nums">
                  0{i + 1}
                </span>
                <h3 class="font-slab text-2xl sm:text-[2rem] font-semibold text-base-content leading-tight group-hover:text-primary transition-colors">
                  {item.title}
                </h3>
                <div class="col-start-2 sm:col-start-3 text-left sm:text-right">
                  <p class="text-sm text-base-content/70">{item.role}</p>
                  <p class="text-xs font-medium tracking-wide uppercase text-base-content/45 mt-0.5">
                    {item.dates}
                  </p>
                </div>
                <span class="hidden sm:block text-base-content/30 group-hover:text-primary group-hover:translate-x-1 transition-all">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
