---
// One narrative beat in the scroll story. Frosted base-100 panel so prose stays
// readable over the mountains (which show softly through the blur). The <slot/>
// holds the body copy.
interface Props {
  id?: string;
  num?: string;
  eyebrow?: string;
  title: string;
  class?: string;
}
const { id, num, eyebrow, title, class: className = "" } = Astro.props;
---

<section id={id} class={`relative py-16 sm:py-24 ${className}`}>
  <div class="container mx-auto px-6 lg:px-16">
    <div
      class="io-reveal mx-auto max-w-3xl rounded-3xl bg-base-100/70 backdrop-blur-md ring-1 ring-base-300/40 shadow-xl px-7 py-10 sm:px-12 sm:py-14"
    >
      {
        (num || eyebrow) && (
          <p class="flex items-center gap-3 text-sm font-medium tracking-[0.16em] uppercase text-primary mb-4">
            {num && <span class="font-slab text-base-content/40">{num}</span>}
            {eyebrow}
          </p>
        )
      }
      <h2
        class="font-slab font-bold text-base-content text-3xl sm:text-[2.5rem] leading-tight tracking-tight"
      >
        {title}
      </h2>
      <div
        class="story-prose mt-6 space-y-5 text-lg leading-relaxed text-base-content/80"
      >
        <slot />
      </div>
    </div>
  </div>
</section>
