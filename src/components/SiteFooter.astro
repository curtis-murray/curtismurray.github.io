---
// Closing band — the dark "base of the mountain". Uses neutral/neutral-content
// so it reads as an earthy footer in autumn-day and a deep one in catppuccin.
const email = "curtis@curtismurray.tech";
const linkedIn = "https://www.linkedin.com/in/curtiswmurray/";
const scholar =
  "https://scholar.google.com.au/citations?user=25fFcUUAAAAJ&hl=en&oi=ao";
import TypeOnView from "./TypeOnView.jsx";
---

<footer
  id="contact"
  class="relative mt-16 bg-neutral text-neutral-content rounded-t-[2.5rem] overflow-hidden scroll-mt-24"
>
  <div class="container mx-auto px-6 lg:px-16 py-16 sm:py-24">
    <div class="io-reveal max-w-3xl">
      <p class="text-sm font-medium tracking-[0.16em] opacity-70 mb-4">
        looking to join a team solving real problems
      </p>
      <h2 class="font-slab font-bold text-4xl sm:text-5xl tracking-tight lowercase">
        <TypeOnView client:visible text="let's build something you can trust." />
      </h2>
      <a
        href={`mailto:${email}`}
        class="group inline-flex items-center gap-3 mt-8 text-xl sm:text-2xl font-medium underline-offset-8 hover:underline"
      >
        {email}
        <span
          aria-hidden="true"
          class="transition-transform group-hover:translate-x-1">→</span
        >
      </a>
    </div>

    <p class="io-reveal mt-12 max-w-2xl text-base sm:text-lg leading-relaxed opacity-80">
      not hiring? stay a while — <a href="/the-grind/" class="text-[#f2a594] font-medium underline underline-offset-4 decoration-[#f2a594]/50 hover:decoration-[#f2a594] transition-colors">judge my life choices</a>, <a href="/blog/" class="text-[#f2a594] font-medium underline underline-offset-4 decoration-[#f2a594]/50 hover:decoration-[#f2a594] transition-colors">read a post</a>, or just <a href="/photography/" class="text-[#f2a594] font-medium underline underline-offset-4 decoration-[#f2a594]/50 hover:decoration-[#f2a594] transition-colors">stop for some photos of birds</a>.
    </p>

    <div
      class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4 text-sm font-medium"
    >
      <a href={linkedIn} target="_blank" rel="noopener noreferrer" class="opacity-80 hover:opacity-100 transition-opacity">be an edge in my network</a>
      <a href={scholar} target="_blank" rel="noopener noreferrer" class="opacity-80 hover:opacity-100 transition-opacity">cite my papers????</a>
    </div>

    <div
      class="mt-14 pt-6 border-t border-neutral-content/15 flex flex-wrap justify-between gap-4 text-xs opacity-60"
    >
      <span>Curtis Murray, PhD · Melbourne, Australia</span>
      <span>© {new Date().getFullYear()} · Built with Astro</span>
    </div>
  </div>
</footer>
