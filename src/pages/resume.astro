---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import Card from "../components/Card";
import Tag from "../components/Tag";
import PageHeader from "../components/PageHeader.astro";
import PdfViewer from "../components/PdfViewer.jsx";
const education = await getCollection("education");
const experience = await getCollection("experience");
const knowledges = await getCollection("knowledges");
const tools = [
  "Python", "TypeScript", "Claude Code", "MCP", "PyTorch", "HuggingFace",
  "TensorFlow", "Neo4j", "AWS Bedrock", "GCP", "Docker", "PostgreSQL",
  "SQL", "R", "Bash", "Git", "Slurm HPC", "LaTeX",
];
import { FaGraduationCap, FaBriefcase } from "react-icons/fa6";
---

<Layout
  title="Resume — Curtis Murray · AI Engineer · Agentic AI · LLMs · RAG · MCP"
>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <PageHeader eyebrow="the facts, on one page" title="résumé" />
    <PdfViewer client:load label="open pdf" />
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
    <div>
      <div class="flex items-center gap-3 mb-5">
        <span class="text-3xl text-primary"><FaGraduationCap /></span>
        <h2 class="font-slab text-2xl font-semibold text-base-content">
          education
        </h2>
      </div>
      {education.map((details) => <Card details={details} />)}
    </div>

    <div>
      <div class="flex items-center gap-3 mb-5">
        <span class="text-3xl text-primary"><FaBriefcase /></span>
        <h2 class="font-slab text-2xl font-semibold text-base-content">
          experience
        </h2>
      </div>
      {experience.map((details) => <Card details={details} />)}
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12 pt-10 border-t border-base-300/50">
    <div>
      <h2 class="font-slab text-2xl font-semibold text-base-content mb-6">
        tech stack
      </h2>
      <div class="flex gap-2.5 flex-wrap">
        {tools.map((item) => <Tag tagName={item} />)}
      </div>
    </div>
    <div>
      <h2 class="font-slab text-2xl font-semibold text-base-content mb-6">
        domains
      </h2>
      <div class="flex gap-2.5 flex-wrap">
        {knowledges[0].data.skill.map((item) => <Tag tagName={item} />)}
      </div>
    </div>
  </div>
</Layout>
