  <script is:inline>
    /* Draws the hub→spoke wires for the triad figure: all three originate at the
       Construction card's right edge and fan out to each related card. The
       FOLLOWS_RULE wire is dashed. Stroke/fill use currentColor so the wires
       follow the theme (.kg-wires sets color from a DaisyUI token). */
    (function () {
      var NS = "http://www.w3.org/2000/svg";
      function el(n, a) { var e = document.createElementNS(NS, n); for (var k in a) e.setAttribute(k, a[k]); return e; }
      function draw() {
        var wrap = document.querySelector(".kg-hub2"); if (!wrap) return;
        var svg = wrap.querySelector(".kg-wires");
        var hub = wrap.querySelector(".kg-hubcell .kg-card");
        var spokes = [].slice.call(wrap.querySelectorAll(".kg-spoke"));
        if (!svg || !hub || !spokes.length) return;
        var wr = wrap.getBoundingClientRect(); if (wr.width < 2) return;
        while (svg.firstChild) svg.removeChild(svg.firstChild);
        [].slice.call(wrap.querySelectorAll(".kg-rel")).forEach(function (c) { c.parentNode.removeChild(c); });
        svg.setAttribute("viewBox", "0 0 " + wr.width + " " + wr.height);
        var defs = el("defs", {});
        var mk = el("marker", { id: "kgar", viewBox: "0 0 10 10", refX: "8", refY: "5", markerWidth: "6", markerHeight: "6", orient: "auto" });
        mk.appendChild(el("path", { d: "M0 0L10 5L0 10z", fill: "currentColor" }));
        defs.appendChild(mk); svg.appendChild(defs);
        var hb = hub.getBoundingClientRect();
        var x1 = hb.right - wr.left, y1 = hb.top - wr.top + hb.height / 2;
        spokes.forEach(function (sp) {
          var card = sp.querySelector(".kg-card"); if (!card) return;
          var cb = card.getBoundingClientRect();
          var x2 = cb.left - wr.left, y2 = cb.top - wr.top + cb.height / 2;
          var opt = sp.hasAttribute("data-optional");
          var dx = Math.max(40, (x2 - x1) * 0.45);
          var d = "M" + x1 + " " + y1 + " C" + (x1 + dx) + " " + y1 + " " + (x2 - dx) + " " + y2 + " " + x2 + " " + y2;
          svg.appendChild(el("path", { d: d, fill: "none", stroke: "currentColor", "stroke-width": "2",
            "stroke-dasharray": opt ? "5 4" : "none", "marker-end": "url(#kgar)" }));
          var chip = document.createElement("span");
          chip.className = "kg-rel" + (opt ? " kg-rel--opt" : "");
          chip.textContent = sp.getAttribute("data-rel") || "";
          chip.style.left = ((x1 + x2) / 2) + "px";
          chip.style.top = ((y1 + y2) / 2) + "px";
          wrap.appendChild(chip);
        });
      }
      function schedule() { clearTimeout(window.__kgw); window.__kgw = setTimeout(draw, 120); }
      if (document.readyState !== "loading") schedule(); else window.addEventListener("DOMContentLoaded", schedule);
      window.addEventListener("load", schedule);
      window.addEventListener("resize", schedule);
      if (window.ResizeObserver) { var ro = new ResizeObserver(schedule); var f = document.querySelector(".kgfig"); if (f) ro.observe(f); }
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(schedule);
    })();
  </script>
