---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
const fieldClass =
  "block py-2.5 px-0 w-full text-base text-base-content bg-transparent border-0 border-b-2 border-base-300 appearance-none focus:outline-none focus:ring-0 focus:border-primary peer";
const labelClass =
  "peer-focus:font-medium absolute text-sm text-base-content/55 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:left-0 peer-focus:text-primary peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-8";
---

<Layout
  title="Contact — Curtis Murray · AI Engineer · Agentic AI · LLMs · RAG · MCP"
>
  <PageHeader eyebrow="say hello" title="get in touch" />
  <p class="-mt-4 mb-9 max-w-2xl text-lg leading-relaxed text-base-content/75">
    Open to AI engineering roles and available immediately. Drop a line below, or
    email <a class="text-primary hover:underline underline-offset-4" href="mailto:curtis@curtismurray.tech">curtis@curtismurray.tech</a>.
  </p>

  <form action="https://formspree.io/f/mayrqeqn" method="POST" class="max-w-2xl">
    <div
      class="returnmessage"
      data-success="Your message has been received, We will contact you soon."
    >
    </div>
    <div class="empty_notice">
      <span class="text-base-content/70">Please fill required fields</span>
    </div>

    <div class="relative z-0 w-full mt-6 mb-8 group">
      <input type="text" id="name" name="name" class={fieldClass} placeholder=" " required="" />
      <label for="name" class={labelClass}>Name *</label>
    </div>

    <div class="relative z-0 w-full mb-8 group">
      <input type="email" name="email" id="email" class={fieldClass} placeholder=" " required="" />
      <label for="email" class={labelClass}>Email *</label>
    </div>

    <div class="relative z-0 w-full mb-8 group">
      <input type="text" name="message" id="message" class={fieldClass} placeholder=" " required="" />
      <label for="message" class={labelClass}>Message *</label>
    </div>

    <input
      type="submit"
      class="inline-flex cursor-pointer rounded-full bg-primary px-7 py-3 font-medium text-primary-content shadow-lg shadow-primary/20 transition-all hover:-translate-y-0.5"
      value="Send message"
    />
  </form>
</Layout>
