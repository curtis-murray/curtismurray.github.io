---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import StoryCard from "../components/StoryCard.jsx";
import WorkList from "../components/WorkList.astro";
import SiteFooter from "../components/SiteFooter.astro";
import GroundingLoop from "../components/GroundingLoop.jsx";
---

<Layout
  story
  title="Curtis Murray · AI Engineer — grounding LLMs in something you can trust"
>
  <Hero />

  <!-- the thesis + the propose → ground → dispose loop, stacked in one card.
       the loop holds (startAfter) until the thesis above finishes typing. -->
  <section id="thesis" class="relative py-16 sm:py-24">
    <div class="container mx-auto px-6 lg:px-16">
      <div class="io-reveal mx-auto max-w-4xl rounded-3xl bg-base-100/60 backdrop-blur-md ring-1 ring-base-300/25 shadow-lg px-7 py-10 sm:px-12 sm:py-14">
        <StoryCard
          client:visible
          title="your LLM is confidently wrong, and you can't see where."
          bare
          emitOnDone="thesis:typed"
          body={[
            "constrain it to reason over real, verified entities and it can't invent what isn't there. evaluate every tool call and the reasoning has nowhere to hide.",
            "this is how I built the first working morphological analyser for spoken Tamil.",
          ]}
        />

        <div id="grounding" class="mt-12 sm:mt-14 pt-10 sm:pt-12 border-t border-base-300/25">
          <GroundingLoop
            client:visible
            bare
            subtitle
            startAfter="thesis:typed"
            title="watch it refuse to make things up, neurosymbolically."
          />
        </div>
      </div>
    </div>
  </section>

  <WorkList />

  <SiteFooter />
</Layout>
